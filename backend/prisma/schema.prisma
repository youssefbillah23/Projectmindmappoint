generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  LINKEDIN
  TWITTER
  INSTAGRAM
}

enum BriefingStatus {
  GENERATING
  READY
  DELIVERED
}

enum InteractionAction {
  EXPAND
  SKIP
  LISTEN
  SAVE
  SHARE
}

enum PostStatus {
  DRAFT
  SCHEDULED
  POSTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  password     String
  name         String
  avatar       String?
  timezone     String   @default("America/New_York")
  briefingTime String   @default("07:00")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  platformConnections PlatformConnection[]
  savedItems          SavedItem[]
  interestGraph       InterestGraph[]
  briefings           Briefing[]
  userInteractions    UserInteraction[]
  libraryItems        LibraryItem[]
  generatedPosts      GeneratedPost[]

  @@map("users")
}

model PlatformConnection {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  platform     Platform
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("platform_connections")
}

model SavedItem {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  platform     Platform
  externalId   String
  contentType  String?
  title        String?
  body         String?  @db.Text
  url          String?
  mediaUrl     String?
  topicTags    String[]
  summaryShort String?
  summaryLong  String?  @db.Text
  savedAt      DateTime?
  syncedAt     DateTime?
  createdAt    DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userInteractions UserInteraction[]
  libraryItems     LibraryItem[]

  @@unique([userId, externalId])
  @@map("saved_items")
}

model InterestGraph {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  topic            String
  score            Float    @default(0)
  interactionCount Int      @default(0)
  lastUpdated      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@map("interest_graph")
}

model Briefing {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  date      DateTime       @db.Date
  status    BriefingStatus @default(GENERATING)
  createdAt DateTime       @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories BriefingStory[]

  @@map("briefings")
}

model BriefingStory {
  id             String   @id @default(uuid()) @db.Uuid
  briefingId     String   @db.Uuid
  title          String
  summaryShort   String?
  summaryLong    String?  @db.Text
  sourceUrl      String?
  topicTag       String?
  audioUrl       String?
  relevanceScore Float    @default(0)
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  briefing         Briefing          @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  userInteractions UserInteraction[]
  libraryItems     LibraryItem[]

  @@map("briefing_stories")
}

model UserInteraction {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  storyId     String?           @db.Uuid
  savedItemId String?           @db.Uuid
  action      InteractionAction
  createdAt   DateTime          @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     BriefingStory? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  savedItem SavedItem?     @relation(fields: [savedItemId], references: [id], onDelete: SetNull)

  @@map("user_interactions")
}

model LibraryItem {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  storyId     String?   @db.Uuid
  savedItemId String?   @db.Uuid
  tags        String[]
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     BriefingStory? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  savedItem SavedItem?     @relation(fields: [savedItemId], references: [id], onDelete: SetNull)

  @@map("library_items")
}

model GeneratedPost {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  sourceItemId String
  platform     Platform
  draftText    String     @db.Text
  tone         String?
  status       PostStatus @default(DRAFT)
  scheduledAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("generated_posts")
}
