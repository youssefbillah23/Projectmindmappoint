# PulsePoint Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/pulsepoint

# Redis
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=your-jwt-secret-min-32-chars-long-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars

# Encryption (32-byte hex key for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Twitter/X OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Instagram OAuth (via Facebook Developer App)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=

# NewsAPI
NEWS_API_KEY=

# S3/R2 Storage
S3_BUCKET_NAME=pulsepoint-audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
